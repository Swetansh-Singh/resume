---
import { resumeData } from '../data/resume';
---

<section id="academics" class="py-24 border-t border-neutral-900 relative">
  <div class="max-w-6xl mx-auto px-6">
    
    <!-- Section Heading -->
    <div class="section-heading mb-16">
      <div class="flex items-center gap-3 text-xs font-mono text-blue-400 mb-2">
        <span>04 //</span>
        <span class="tracking-widest uppercase">Academic Background</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">
        Education & Qualifications
      </h2>
    </div>

    <!-- Education Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {resumeData.education.map((edu) => (
        <div class="p-6 sm:p-7 rounded-xl bg-neutral-900/40 border border-neutral-800/80 hover:border-neutral-700/80 transition-colors flex flex-col justify-between" data-tilt="true">
          <div>
            <div class="flex items-start justify-between gap-2 mb-2">
              <h3 class="text-base font-bold text-white leading-snug">
                {edu.degree}
              </h3>
            </div>
            
            <p class="text-xs font-mono text-blue-400 mb-1">
              {edu.institution}
            </p>
            
            <p class="text-[11px] font-mono text-neutral-500 mb-4">
              {edu.location} • {edu.period}
            </p>

            {edu.details && (
              <ul class="space-y-1.5 mb-5 pl-2 border-l border-neutral-800">
                {edu.details.map((detail) => (
                  <li class="text-xs text-neutral-400 flex items-start gap-1.5 leading-relaxed">
                    <span class="text-blue-400">▹</span>
                    <span>{detail}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>

          {edu.grade && (
            <div class="pt-4 border-t border-neutral-800/80 mt-auto flex items-center justify-between">
              <span class="text-[11px] font-mono text-neutral-500 uppercase tracking-wider">Score</span>
              <span class="inline-block px-2.5 py-1 rounded bg-blue-500/10 border border-blue-500/20 text-blue-400 font-mono text-xs font-semibold">
                {edu.grade}
              </span>
            </div>
          )}
        </div>
      ))}
    </div>

  </div>
</section>


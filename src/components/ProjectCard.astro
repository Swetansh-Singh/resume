---
import type { ProjectItem } from '../lib/github';
import { getLanguageColor } from '../lib/languageColors';

interface Props {
  project: ProjectItem;
}

const { project } = Astro.props;
const langColor = getLanguageColor(project.language);
---

<div
  class="project-card group relative rounded-xl bg-neutral-900/40 border border-neutral-800/80 hover:border-neutral-700/80 p-6 flex flex-col justify-between transition-all duration-300 hover:shadow-xl hover:shadow-black/40 overflow-hidden"
  data-tilt="true"
  data-language={project.language}
>
  <!-- Interactive border glow layer controlled by mousemove -->
  <div
    class="pointer-events-none absolute -inset-px rounded-xl opacity-0 transition-opacity duration-300 group-hover:opacity-100"
    style="background: radial-gradient(400px circle at var(--mouse-x, 150px) var(--mouse-y, 100px), rgba(59, 130, 246, 0.12), transparent 40%);"
  ></div>

  <div>
    <!-- Top Metadata Bar -->
    <div class="flex items-center justify-between gap-2 mb-4">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full" style={`background-color: ${langColor}`}></span>
        <span class="text-xs font-mono text-neutral-400">{project.language}</span>
      </div>

      {project.featured && (
        <span class="px-2 py-0.5 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-[10px] font-semibold font-mono uppercase tracking-wider">
          Featured
        </span>
      )}
    </div>

    <!-- Title -->
    <h3 class="text-lg font-bold text-white group-hover:text-blue-400 transition-colors mb-2 tracking-tight">
      <a href={project.htmlUrl} target="_blank" rel="noopener noreferrer" class="hover:underline">
        {project.title}
      </a>
    </h3>

    <!-- Description -->
    <p class="text-xs sm:text-sm text-neutral-400 leading-relaxed mb-4">
      {project.description}
    </p>

    <!-- Project Highlights (if present) -->
    {project.highlights && project.highlights.length > 0 && (
      <ul class="space-y-1.5 mb-5 pl-2 border-l border-neutral-800">
        {project.highlights.map((item) => (
          <li class="text-[11px] sm:text-xs text-neutral-400 flex items-start gap-1.5">
            <span class="text-blue-400">▹</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    )}
  </div>

  <div>
    <!-- Tags -->
    {project.tags && project.tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 mb-5">
        {project.tags.slice(0, 4).map((tag) => (
          <span class="px-2 py-0.5 rounded bg-neutral-950 border border-neutral-800 text-[10px] font-mono text-neutral-400">
            {tag}
          </span>
        ))}
      </div>
    )}

    <!-- Card Footer Links -->
    <div class="flex items-center justify-between pt-4 border-t border-neutral-800/60 text-xs font-mono">
      <a
        href={project.htmlUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-neutral-300 hover:text-white transition-colors group-hover:text-blue-400"
      >
        <svg class="w-4 h-4 text-neutral-400 group-hover:text-blue-400 transition-colors" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
        </svg>
        <span>View Repository</span>
        <span class="text-neutral-500 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform duration-200">↗</span>
      </a>
    </div>
  </div>
</div>


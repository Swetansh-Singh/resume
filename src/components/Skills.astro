---
import { resumeData } from '../data/resume';
---

<section id="skills" class="py-12 md:py-16 border-t border-neutral-900 relative">
  <div class="max-w-6xl mx-auto px-6">
    
    <!-- Section Heading -->
    <div class="section-heading mb-8">
      <div class="flex items-center gap-3 text-xs font-mono text-blue-400 mb-2">
        <span>03 //</span>
        <span class="tracking-widest uppercase">Technical Skills</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">
        Skills & Core Competencies
      </h2>
    </div>

    <!-- Categorized Skill Columns -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
      {resumeData.skillCategories.map((cat, catIdx) => (
        <div class="p-6 rounded-xl bg-neutral-900/40 border border-neutral-800/80 hover:border-neutral-700/80 transition-colors" data-tilt="true">
          <div class="flex items-center gap-2 mb-4">
            <span class="text-xs font-mono text-blue-400">0{catIdx + 1}.</span>
            <h3 class="text-sm font-bold text-white tracking-tight">{cat.title}</h3>
          </div>

          <div class="flex flex-wrap gap-2">
            {cat.skills.map((skill) => (
              <span class="skill-tag px-2.5 py-1 rounded-lg bg-neutral-950 border border-neutral-800/90 hover:border-blue-500/50 hover:bg-neutral-900 text-xs font-mono text-neutral-300 hover:text-white transition-all duration-200">
                {skill.name}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Personal Strengths & Spoken Languages -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
      <div class="md:col-span-7 p-6 rounded-xl bg-neutral-900/30 border border-neutral-800/70">
        <h4 class="text-xs font-mono uppercase tracking-wider text-neutral-400 mb-3 flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span>Professional Strengths</span>
        </h4>
        <div class="flex flex-wrap gap-2">
          {resumeData.personalStrengths.map((strength) => (
            <span class="px-2.5 py-1 rounded-md bg-neutral-950 border border-neutral-800 text-xs font-mono text-neutral-300">
              {strength}
            </span>
          ))}
        </div>
      </div>

      <div class="md:col-span-5 p-6 rounded-xl bg-neutral-900/30 border border-neutral-800/70">
        <h4 class="text-xs font-mono uppercase tracking-wider text-neutral-400 mb-3 flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
          <span>Spoken Languages</span>
        </h4>
        <div class="flex flex-wrap gap-2">
          {resumeData.spokenLanguages.map((lang) => (
            <span class="px-2.5 py-1 rounded-md bg-neutral-950 border border-neutral-800 text-xs font-mono text-neutral-300">
              {lang.name} <span class="text-neutral-500">• {lang.proficiency}</span>
            </span>
          ))}
        </div>
      </div>
    </div>

  </div>
</section>

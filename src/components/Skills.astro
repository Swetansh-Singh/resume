---
import { resumeData } from '../data/resume';

const marqueeTech = [
  'Python', 'TensorFlow', 'OpenCV', 'Scikit-Learn', 'CNNs', 'Computer Vision',
  'Streamlit', 'Pandas', 'NumPy', 'Plotly', 'Seaborn', 'Matplotlib',
  'SQL', 'EDA', 'Feature Engineering', 'Forecasting', 'Git & GitHub'
];

const personalStrengths = [
  'Analytical Problem-Solving',
  'Cross-Functional Communication',
  'Team Leadership',
  'Time Management',
  'Rapid Adaptability',
];
---

<section id="skills" class="py-24 border-t border-neutral-900 relative overflow-hidden">
  <div class="max-w-6xl mx-auto px-6">
    
    <!-- Section Heading -->
    <div class="section-heading mb-16">
      <div class="flex items-center gap-3 text-xs font-mono text-blue-400 mb-2">
        <span>04 //</span>
        <span class="tracking-widest uppercase">Technical Expertise</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">
        Skills & Core Competencies
      </h2>
    </div>

    <!-- Categorized Skill Columns -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
      {resumeData.skillCategories.map((cat, catIdx) => (
        <div class="p-6 sm:p-8 rounded-xl bg-neutral-900/40 border border-neutral-800/80 hover:border-neutral-700/80 transition-colors">
          <div class="flex items-center gap-2 mb-6">
            <span class="text-xs font-mono text-blue-400">0{catIdx + 1}.</span>
            <h3 class="text-base font-bold text-white tracking-tight">{cat.title}</h3>
          </div>

          <div class="flex flex-wrap gap-2.5">
            {cat.skills.map((skill) => (
              <span class="skill-tag px-3 py-1.5 rounded-lg bg-neutral-950 border border-neutral-800/90 hover:border-blue-500/50 hover:bg-neutral-900 text-xs font-mono text-neutral-300 hover:text-white transition-all duration-200">
                {skill.name}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Strengths & Spoken Languages Row -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 mb-16">
      
      <!-- Personal Strengths -->
      <div class="md:col-span-7 p-6 rounded-xl bg-neutral-900/30 border border-neutral-800/70">
        <h4 class="text-xs font-mono uppercase tracking-wider text-neutral-400 mb-4 flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span>Professional Strengths</span>
        </h4>
        <div class="flex flex-wrap gap-2">
          {personalStrengths.map((strength) => (
            <span class="px-3 py-1 rounded-md bg-neutral-950 border border-neutral-800 text-xs font-mono text-neutral-300">
              {strength}
            </span>
          ))}
        </div>
      </div>

      <!-- Spoken Languages -->
      <div class="md:col-span-5 p-6 rounded-xl bg-neutral-900/30 border border-neutral-800/70">
        <h4 class="text-xs font-mono uppercase tracking-wider text-neutral-400 mb-4 flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-purple-400"></span>
          <span>Languages</span>
        </h4>
        <div class="flex flex-wrap gap-3">
          {resumeData.spokenLanguages.map((lang) => (
            <div class="px-3 py-1.5 rounded-lg bg-neutral-950 border border-neutral-800 flex items-center gap-2 text-xs font-mono">
              <span class="text-neutral-200 font-semibold">{lang.name}</span>
              <span class="text-neutral-500 text-[11px]">— {lang.proficiency}</span>
            </div>
          ))}
        </div>
      </div>

    </div>

    <!-- Tech Marquee Banner -->
    <div class="relative py-6 rounded-2xl bg-[#0d0d0d] border border-neutral-800/80 overflow-hidden">
      <!-- Gradient Edge Masks -->
      <div class="absolute left-0 top-0 bottom-0 w-24 bg-gradient-to-r from-[#0d0d0d] to-transparent z-10 pointer-events-none"></div>
      <div class="absolute right-0 top-0 bottom-0 w-24 bg-gradient-to-l from-[#0d0d0d] to-transparent z-10 pointer-events-none"></div>

      <div class="marquee-track flex gap-8 whitespace-nowrap text-sm font-mono text-neutral-400">
        <div class="flex items-center gap-8 animate-marquee">
          {marqueeTech.map((tech) => (
            <div class="flex items-center gap-3">
              <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
              <span class="hover:text-white transition-colors">{tech}</span>
            </div>
          ))}
        </div>
        <div class="flex items-center gap-8 animate-marquee" aria-hidden="true">
          {marqueeTech.map((tech) => (
            <div class="flex items-center gap-3">
              <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
              <span class="hover:text-white transition-colors">{tech}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  @keyframes marquee {
    0% { transform: translateX(0%); }
    100% { transform: translateX(-100%); }
  }

  .animate-marquee {
    animation: marquee 25s linear infinite;
  }

  .marquee-track:hover .animate-marquee {
    animation-play-state: paused;
  }
</style>

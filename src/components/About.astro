---
import { resumeData } from '../data/resume';
---

<section id="about" class="py-24 border-t border-neutral-900 relative">
  <div class="max-w-6xl mx-auto px-6">
    
    <!-- Section Heading -->
    <div class="section-heading mb-16">
      <div class="flex items-center gap-3 text-xs font-mono text-blue-400 mb-2">
        <span>01 //</span>
        <span class="tracking-widest uppercase">About Me</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">
        Engineered for clarity, performance & impact.
      </h2>
    </div>

    <!-- Main Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Narrative Bio -->
      <div class="lg:col-span-7 space-y-6 text-neutral-300 text-base sm:text-lg leading-relaxed">
        {resumeData.about.summary.map((para) => (
          <p class="text-neutral-400 font-normal">
            {para}
          </p>
        ))}

        <div class="pt-4 flex flex-wrap gap-3">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-lg bg-neutral-900 border border-neutral-800 text-xs font-mono text-neutral-300">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span>Fast Prototyping</span>
          </div>
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-lg bg-neutral-900 border border-neutral-800 text-xs font-mono text-neutral-300">
            <span class="w-2 h-2 rounded-full bg-blue-400"></span>
            <span>Mathematical Grounding</span>
          </div>
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-lg bg-neutral-900 border border-neutral-800 text-xs font-mono text-neutral-300">
            <span class="w-2 h-2 rounded-full bg-purple-400"></span>
            <span>Clean Minimal Architecture</span>
          </div>
        </div>
      </div>

      <!-- Feature Highlight Pillars -->
      <div class="lg:col-span-5 grid grid-cols-1 gap-4">
        <div class="p-6 rounded-xl bg-neutral-900/50 border border-neutral-800/80 hover:border-neutral-700 transition-colors" data-tilt="true">
          <div class="w-10 h-10 rounded-lg bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-400 font-mono text-sm mb-4">
            01
          </div>
          <h3 class="text-base font-semibold text-white mb-2">Data Science & Vision</h3>
          <p class="text-sm text-neutral-400 leading-relaxed">
            Training neural networks, analyzing high-dimensional datasets, and engineering predictive workflows that solve concrete diagnostic or commercial challenges.
          </p>
        </div>

        <div class="p-6 rounded-xl bg-neutral-900/50 border border-neutral-800/80 hover:border-neutral-700 transition-colors" data-tilt="true">
          <div class="w-10 h-10 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 font-mono text-sm mb-4">
            02
          </div>
          <h3 class="text-base font-semibold text-white mb-2">Automated Dashboards</h3>
          <p class="text-sm text-neutral-400 leading-relaxed">
            Building intuitive interfaces with Streamlit and modern tooling that empower stakeholders to explore datasets with zero SQL friction.
          </p>
        </div>

        <div class="p-6 rounded-xl bg-neutral-900/50 border border-neutral-800/80 hover:border-neutral-700 transition-colors" data-tilt="true">
          <div class="w-10 h-10 rounded-lg bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-purple-400 font-mono text-sm mb-4">
            03
          </div>
          <h3 class="text-base font-semibold text-white mb-2">Craft & Clean Code</h3>
          <p class="text-sm text-neutral-400 leading-relaxed">
            Obsessive focus on readable structure, type safety, low bundle size, and animations that enhance rather than distract.
          </p>
        </div>
      </div>

    </div>
  </div>
</section>


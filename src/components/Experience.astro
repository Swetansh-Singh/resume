---
import { resumeData } from '../data/resume';
---

<section id="experience" class="py-24 border-t border-neutral-900 relative">
  <div class="max-w-6xl mx-auto px-6">
    
    <!-- Section Heading -->
    <div class="section-heading mb-16">
      <div class="flex items-center gap-3 text-xs font-mono text-blue-400 mb-2">
        <span>02 //</span>
        <span class="tracking-widest uppercase">Career & Projects</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">
        Experience & Milestones
      </h2>
    </div>

    <!-- Timeline Container -->
    <div class="timeline-container relative pl-6 sm:pl-10 border-l border-neutral-800">
      
      <!-- Animated Scroll-Scrubbed Line Overlay -->
      <div class="timeline-progress-line absolute top-0 left-[-1px] w-[2px] h-full bg-gradient-to-b from-blue-500 via-emerald-500 to-purple-500 origin-top"></div>

      <div class="space-y-12">
        {resumeData.experience.map((exp, index) => (
          <div class="timeline-item relative">
            <!-- Timeline node circle -->
            <div class="absolute -left-[31px] sm:-left-[47px] top-1.5 w-3.5 h-3.5 rounded-full bg-neutral-950 border-2 border-blue-400 shadow-sm shadow-blue-500/50"></div>

            <div class="p-6 sm:p-8 rounded-xl bg-neutral-900/40 border border-neutral-800/80 hover:border-neutral-700/80 transition-colors">
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-3">
                <div>
                  <h3 class="text-xl font-bold text-white tracking-tight">
                    {exp.role}
                  </h3>
                  <div class="flex items-center gap-2 text-sm text-blue-400 font-mono mt-0.5">
                    <span>{exp.company}</span>
                    <span>•</span>
                    <span class="text-neutral-500">{exp.location}</span>
                  </div>
                </div>
                <div class="px-3 py-1 rounded-full bg-neutral-800/80 border border-neutral-700/60 text-xs font-mono text-neutral-300 self-start sm:self-auto">
                  {exp.period}
                </div>
              </div>

              <p class="text-neutral-300 text-sm sm:text-base mb-4 leading-relaxed">
                {exp.description}
              </p>

              <!-- Bullet Points -->
              <ul class="space-y-2 mb-6">
                {exp.bulletPoints.map((bullet) => (
                  <li class="flex items-start gap-2.5 text-xs sm:text-sm text-neutral-400">
                    <span class="text-blue-400 mt-1">▹</span>
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>

              <!-- Skills tags -->
              <div class="flex flex-wrap gap-2 pt-2 border-t border-neutral-800/60">
                {exp.skills.map((skill) => (
                  <span class="px-2.5 py-1 rounded bg-neutral-950 border border-neutral-800 text-[11px] font-mono text-neutral-400">
                    {skill}
                  </span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>

    </div>

    <!-- Education Section -->
    <div class="mt-20 pt-16 border-t border-neutral-900">
      <div class="flex items-center gap-3 text-xs font-mono text-blue-400 mb-8">
        <span>// Academic Background</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {resumeData.education.map((edu) => (
          <div class="p-6 rounded-xl bg-neutral-900/40 border border-neutral-800 hover:border-neutral-700 transition-colors flex flex-col justify-between">
            <div>
              <div class="flex items-start justify-between gap-2 mb-2">
                <h4 class="text-sm font-bold text-white leading-snug">{edu.degree}</h4>
              </div>
              <p class="text-xs font-mono text-blue-400 mb-1">{edu.institution}</p>
              <p class="text-[11px] font-mono text-neutral-500 mb-4">{edu.location} • {edu.period}</p>
              {edu.details && (
                <ul class="space-y-1.5 mb-4">
                  {edu.details.map((detail) => (
                    <li class="text-xs text-neutral-400 flex items-start gap-2">
                      <span class="text-neutral-600">▪</span>
                      <span>{detail}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
            {edu.grade && (
              <div class="pt-3 border-t border-neutral-800/80 mt-auto">
                <span class="inline-block px-2.5 py-1 rounded bg-blue-500/10 border border-blue-500/20 text-blue-400 font-mono text-xs font-semibold">
                  {edu.grade}
                </span>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>

  </div>
</section>


---
import { resumeData } from '../data/resume';
---

<section id="contact" class="py-24 border-t border-neutral-900 relative">
  <div class="max-w-6xl mx-auto px-6">
    
    <div class="max-w-3xl mx-auto text-center">
      <!-- Section Tag -->
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-neutral-900 border border-neutral-800 text-xs font-mono text-blue-400 mb-6">
        <span>05 // Contact</span>
      </div>

      <h2 class="text-4xl sm:text-5xl font-bold text-white tracking-tight mb-6">
        Let’s build something impactful together.
      </h2>

      <p class="text-base sm:text-lg text-neutral-400 mb-10 leading-relaxed max-w-xl mx-auto">
        Whether you have an interesting data challenge, an engineering opportunity, or simply want to chat about AI and machine learning — my inbox is always open.
      </p>

      <!-- Interactive Contact Actions -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-12">
        <!-- Direct mail link -->
        <a
          href={`mailto:${resumeData.contacts.email}`}
          class="w-full sm:w-auto px-7 py-3.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-medium text-sm transition-all duration-200 shadow-lg shadow-blue-500/20 hover:shadow-blue-500/30 flex items-center justify-center gap-2"
          data-magnetic="true"
          data-magnetic-strength="0.2"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
          <span>Send an Email</span>
        </a>

        <!-- Copy Email Button -->
        <button
          id="copy-email-btn"
          class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-neutral-900 hover:bg-neutral-800 text-neutral-300 hover:text-white border border-neutral-800 hover:border-neutral-700 text-sm font-mono transition-all duration-200 flex items-center justify-center gap-2"
          data-email={resumeData.contacts.email}
          data-magnetic="true"
          data-magnetic-strength="0.2"
        >
          <svg class="w-4 h-4 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
          </svg>
          <span id="copy-text">Copy address</span>
        </button>
      </div>

      <!-- Social Links Row -->
      <div class="flex items-center justify-center gap-6 text-sm font-mono">
        <a
          href={resumeData.contacts.github}
          target="_blank"
          rel="noopener noreferrer"
          class="text-neutral-400 hover:text-white transition-colors flex items-center gap-2"
        >
          <span>GitHub</span>
          <span class="text-neutral-600">↗</span>
        </a>
        <span class="text-neutral-700">•</span>
        <a
          href={resumeData.contacts.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="text-neutral-400 hover:text-white transition-colors flex items-center gap-2"
        >
          <span>LinkedIn</span>
          <span class="text-neutral-600">↗</span>
        </a>
      </div>

      <!-- Floating notification toast for email copy -->
      <div
        id="toast"
        class="fixed bottom-6 right-6 z-50 transform translate-y-12 opacity-0 pointer-events-none transition-all duration-300 px-4 py-2.5 rounded-lg bg-neutral-900 border border-neutral-700 text-white text-xs font-mono flex items-center gap-2 shadow-2xl"
      >
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        <span>Email copied to clipboard!</span>
      </div>

    </div>

  </div>
</section>

<script>
  const copyBtn = document.getElementById('copy-email-btn');
  const copyText = document.getElementById('copy-text');
  const toast = document.getElementById('toast');

  if (copyBtn && copyText && toast) {
    copyBtn.addEventListener('click', async () => {
      const email = copyBtn.dataset.email || 'swetanshsingh@example.com';
      try {
        await navigator.clipboard.writeText(email);
        copyText.textContent = 'Copied!';
        toast.classList.remove('translate-y-12', 'opacity-0', 'pointer-events-none');
        toast.classList.add('translate-y-0', 'opacity-100');

        setTimeout(() => {
          copyText.textContent = 'Copy address';
          toast.classList.add('translate-y-12', 'opacity-0', 'pointer-events-none');
          toast.classList.remove('translate-y-0', 'opacity-100');
        }, 2500);
      } catch (err) {
        copyText.textContent = email;
      }
    });
  }
</script>

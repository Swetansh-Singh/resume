---
import { getProjects } from '../lib/github';
import ProjectCard from './ProjectCard.astro';
import { projectsConfig } from '../data/projects.config';

const projects = await getProjects();
const languages = ['All', ...Array.from(new Set(projects.map((p) => p.language).filter(Boolean)))];
---

<section id="projects" class="py-12 md:py-16 border-t border-neutral-900 relative">
  <div class="max-w-6xl mx-auto px-6">
    
    <!-- Section Header -->
    <div class="section-heading flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8">
      <div>
        <div class="flex items-center gap-3 text-xs font-mono text-blue-400 mb-2">
          <span>02 //</span>
          <span class="tracking-widest uppercase">Projects</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">
          Featured GitHub Projects
        </h2>
      </div>

      <!-- Filter buttons -->
      <div class="flex flex-wrap items-center gap-2" id="project-filters">
        {languages.map((lang, index) => (
          <button
            class={`px-3 py-1.5 rounded-lg text-xs font-mono transition-all duration-200 filter-btn ${
              index === 0
                ? 'bg-blue-600/20 text-blue-400 border border-blue-500/40 active-filter'
                : 'bg-neutral-900 text-neutral-400 border border-neutral-800 hover:text-white hover:border-neutral-700'
            }`}
            data-filter={lang}
          >
            {lang}
          </button>
        ))}
      </div>
    </div>

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="projects-grid">
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>

    <!-- Bottom link to GitHub profile -->
    <div class="mt-8 text-center">
      <a
        href={`https://github.com/${projectsConfig.githubUsername}?tab=repositories`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-neutral-900/60 hover:bg-neutral-800 border border-neutral-800 hover:border-neutral-700 text-sm font-mono text-neutral-300 hover:text-white transition-all duration-200"
        data-magnetic="true"
        data-magnetic-strength="0.15"
      >
        <svg class="w-4 h-4 text-blue-400" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
        </svg>
        <span>View all repositories on GitHub ↗</span>
      </a>
    </div>

  </div>
</section>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.project-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const selected = btn.dataset.filter || 'All';

      // Update button styles
      filterBtns.forEach((b) => {
        b.classList.remove('bg-blue-600/20', 'text-blue-400', 'border-blue-500/40', 'active-filter');
        b.classList.add('bg-neutral-900', 'text-neutral-400', 'border-neutral-800');
      });
      btn.classList.add('bg-blue-600/20', 'text-blue-400', 'border-blue-500/40', 'active-filter');
      btn.classList.remove('bg-neutral-900', 'text-neutral-400', 'border-neutral-800');

      // Filter cards
      cards.forEach((card) => {
        const lang = card.dataset.language || '';
        if (selected === 'All' || lang === selected) {
          card.style.display = 'flex';
          card.style.opacity = '1';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>

